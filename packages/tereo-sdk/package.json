{
  "name": "@tereo-io/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "One SDK for app services to reach Tereo: auth, files, webhooks and audit over a single @dianemo/core request handler",
  "keywords": [
    "tereo",
    "sdk",
    "auth",
    "oauth",
    "webhooks",
    "audit",
    "outbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tereo-io/tereo.git",
    "directory": "packages/tereo-sdk"
  },
  "homepage": "https://github.com/tereo-io/tereo/tree/master/packages/tereo-sdk#readme",
  "bugs": {
    "url": "https://github.com/tereo-io/tereo/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "default": "./dist/handler.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/tests",
    "!src/tests",
    "!**/*.tsbuildinfo",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Aaron Leman",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dianemo/backend-redis": "^2.0.0",
    "@dianemo/core": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "express": "^5.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
