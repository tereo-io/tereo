{
  "name": "tereo-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests for Tereo: the admin UI in a real browser against a real core, database and Redis",
  "type": "module",
  "scripts": {
    "e2e": "playwright test --grep-invert @slow",
    "e2e:all": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:core": "tsx src/core/startCore.ts",
    "check": "tsc --noEmit",
    "clean": "rm -rf test-results playwright-report .e2e-state"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "nx": {
    "implicitDependencies": [
      "tereo",
      "tereo-ui"
    ],
    "targets": {
      "check": {
        "dependsOn": []
      },
      "e2e": {
        "cache": false
      },
      "e2e:all": {
        "cache": false
      }
    }
  }
}
