{
  "name": "tereo-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/tereo-ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        { "env": "VITE_CORE_URL" },
        { "env": "VITE_CLIENT_ID" },
        "{workspaceRoot}/packages/tereo/openapi/bundled-openapi.yaml"
      ],
      "options": {
        "command": "node scripts/openapi-sync.mjs && vite build",
        "cwd": "packages/tereo-ui"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/tereo-ui"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/openapi-sync.mjs && vite",
        "cwd": "packages/tereo-ui"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist node_modules/.vite tsconfig.tsbuildinfo",
        "cwd": "packages/tereo-ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "vitest run",
        "cwd": "packages/tereo-ui"
      }
    },
    "test:docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "vitest run",
        "cwd": "packages/tereo-ui"
      }
    }
  }
}
