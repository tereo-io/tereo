{
  "name": "tereo-ui",
  "version": "0.5.0",
  "private": true,
  "description": "Admin UI for Tereo — auth, files, webhooks and audit log",
  "type": "module",
  "scripts": {
    "dev": "npm run openapi:sync && vite",
    "build": "npm run openapi:sync && vite build",
    "check": "tsc --noEmit && node scripts/check-routes.mjs",
    "openapi:sync": "node scripts/openapi-sync.mjs",
    "lint": "eslint src/",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@kosmeo-ui/react": "^0.2.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "axios": "^1.20.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0",
    "redoc": "^2.5.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
