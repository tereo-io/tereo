{
  "name": "tereo-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Admin UI for Tereo — auth, files, webhooks and audit log",
  "type": "module",
  "scripts": {
    "dev": "npm run openapi:sync && vite",
    "build": "npm run openapi:sync && vite build",
    "check": "tsc --noEmit && node scripts/check-routes.mjs",
    "openapi:sync": "node scripts/openapi-sync.mjs",
    "lint": "eslint src/",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@kosmeo-ui/react": "^0.1.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "axios": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.17.0",
    "react-toastify": "^11.1.0",
    "redoc": "^2.5.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
