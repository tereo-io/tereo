# Copy to .env.development.local: the dev server reads it, a production build
# does not.

# Where core is reachable. Unset, the UI uses its own origin (core serves the
# production build at /). In development core runs on :4001 and the UI on
# :4000.
VITE_CORE_URL=http://localhost:4001

# The OAuth client the UI logs in with. Defaults to tereo-ui, the
# client core seeds; set only to use another one.
# VITE_CLIENT_ID=
