// ============================================
// EVENT TYPE REGISTRY
// ============================================

// Declared by a service; `source` is that service's slug. A retired event
// type accepts no new events.
model EventType {
  eventType      String    @id @map("event_type") @db.VarChar(100)
  description    String?
  source         String    @db.VarChar(100)
  serviceId      String    @map("service_id") @db.Uuid
  readPermission String?   @map("read_permission") @db.VarChar(200)
  missingSince   DateTime? @map("missing_since")
  retiredAt      DateTime? @map("retired_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  subscriptions WebhookEndpointEventType[]
  deliveries    WebhookDelivery[]
  service       Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([source])
  @@index([serviceId])
  @@map("event_types")
  @@schema("webhooks")
}

// ============================================
// WEBHOOKS
// ============================================

enum WebhookEndpointStatus {
  ACTIVE
  PAUSED
  DISABLED

  @@schema("webhooks")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED

  @@schema("webhooks")
}

model WebhookEndpoint {
  id                      String                @id @default(uuid(7)) @db.Uuid
  // Null for an endpoint owned by a service (ownerServiceId); one of the two is set.
  organizationId          String?               @map("organization_id") @db.Uuid
  ownerServiceId          String?               @map("owner_service_id") @db.Uuid
  provisioned             Boolean               @default(false)
  provisioningKey         String?               @unique @map("provisioning_key") @db.VarChar(300)
  url                     String                @db.VarChar(2048)
  description             String?
  // Sealed under the KEK (utils/webhookSecrets.ts); a plaintext value from
  // before sealing is sealed on start or on first use.
  signingSecret           String                @map("signing_secret")
  // The first characters of the plaintext secret, shown in place of it.
  signingSecretHint       String?               @map("signing_secret_hint") @db.VarChar(8)
  // The secret a rotation replaced, sealed like signingSecret; deliveries are
  // signed with it as well until previousSecretExpiresAt.
  previousSigningSecret   String?               @map("previous_signing_secret")
  previousSecretExpiresAt DateTime?             @map("previous_secret_expires_at")
  status                  WebhookEndpointStatus @default(ACTIVE)
  customHeaders           Json?                 @map("custom_headers")
  consecutiveFailures     Int                   @default(0) @map("consecutive_failures")
  archivedAt              DateTime?             @map("archived_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  createdBy               String                @map("created_by") @db.Uuid

  deliveries    WebhookDelivery[]
  subscriptions WebhookEndpointEventType[]
  creator       User                       @relation("WebhookEndpointCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  organization  Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ownerService  Service?                   @relation(fields: [ownerServiceId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([ownerServiceId])
  @@index([archivedAt])
  @@map("webhook_endpoints")
  @@schema("webhooks")
}

// The event types an endpoint subscribes to. Removing an endpoint removes its
// subscriptions; an event type with subscribers cannot be removed.
model WebhookEndpointEventType {
  webhookEndpointId String   @map("webhook_endpoint_id") @db.Uuid
  eventType         String   @map("event_type") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at")

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  definition      EventType       @relation(fields: [eventType], references: [eventType], onDelete: Restrict)

  @@id([webhookEndpointId, eventType])
  @@index([eventType])
  @@map("webhook_endpoint_event_types")
  @@schema("webhooks")
}

model WebhookDelivery {
  id                String                @id @default(uuid(7)) @db.Uuid
  webhookEndpointId String                @map("webhook_endpoint_id") @db.Uuid
  eventType         String                @map("event_type") @db.VarChar(100)
  payload           Json
  status            WebhookDeliveryStatus @default(PENDING)
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?             @map("last_attempt_at")
  httpStatus        Int?                  @map("http_status")
  responseBody      String?               @map("response_body") @db.VarChar(4096)
  errorMessage      String?               @map("error_message") @db.VarChar(2048)
  completedAt       DateTime?             @map("completed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Restrict)
  definition      EventType       @relation(fields: [eventType], references: [eventType], onDelete: Restrict)

  // An endpoint's deliveries newest first (the list, stats and bulk retry),
  // and every lookup by endpoint alone.
  @@index([webhookEndpointId, createdAt])
  @@index([status])
  @@map("webhook_deliveries")
  @@schema("webhooks")
}

// An outbox event already fanned out to webhook deliveries, written in the
// transaction that writes them: a re-claimed outbox row finds it and writes
// nothing again. Kept as long as the outbox keeps dead letters.
model WebhookOutboxFanout {
  outboxId  String   @id @map("outbox_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("outbox_fanouts")
  @@schema("webhooks")
}

// ===========================================================================
// audit
// ===========================================================================

enum Action {
  CREATE
  UPDATE
  DELETE
  MERGE
  ARCHIVE
  RESTORE
  LOGIN
  LOGOUT

  @@schema("audit")
}

model AuditLogEntry {
  id             String        @id @default(uuid(7)) @db.Uuid
  source         String        @db.VarChar(100)
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  userEmail      String?       @map("user_email")
  action         Action
  entityType     String        @map("entity_type") @db.VarChar(100)
  // entity_id is polymorphic — references PKs across many services and types
  // (some Int autoincrement, some UUID, some compound). Stays TEXT.
  entityId       String        @map("entity_id")
  entityName     String?       @map("entity_name") @db.VarChar(500)
  changes        Json?
  metadata       Json?
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  correlationId  String?       @map("correlation_id") @db.VarChar(255)
  // Non-spoofable provenance: the authenticated user (for a client, its
  // service-account user) that actually wrote this entry, captured server-side
  // from the bearer token (never the request body); core's system user for
  // entries core writes itself. The business `source`/`userId` above are
  // self-reported by the calling service (the audit log is written on behalf of
  // an end-user), so this column is what makes a forged `source`/`userId`
  // attributable — it records who the platform actually authenticated.
  writerUserId   String        @map("writer_user_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  user           User          @relation("AuditLogEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  writer         User          @relation("AuditLogEntryWriter", fields: [writerUserId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([source])
  @@index([organizationId])
  @@index([userId])
  @@index([userEmail])
  @@index([writerUserId])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_log_entries")
  @@schema("audit")
}

// ===========================================================================
// core
// ===========================================================================

// Transactional outbox. Rows are written in the same transaction as the
// business change and drained by the outbox reaper (src/shared/outbox). Only
// webhook events go through it — audit entries are inserted directly, in the
// caller's transaction. Successfully dispatched rows are deleted; rows that
// exhaust their attempts are kept with `dead_lettered_at` set for replay.
model Outbox {
  id             String    @id @default(uuid(7)) @db.Uuid
  destination    String    @db.VarChar(64)
  payload        Json
  // W3C trace context captured at publish time, so dispatch runs under the
  // originating request's trace. Null for writes outside a trace.
  traceparent    String?   @db.VarChar(64)
  tracestate     String?   @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  claimedAt      DateTime? @map("claimed_at")
  claimedBy      String?   @map("claimed_by")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  deadLetteredAt DateTime? @map("dead_lettered_at")

  // Plus a partial index on next_attempt_at WHERE dead_lettered_at IS NULL,
  // appended as raw SQL in the migration.
  @@index([nextAttemptAt])
  @@index([deadLetteredAt])
  @@map("outbox")
  @@schema("core")
}

// Keys core generated because env did not supply them, named after the env
// variable they stand in for (`FILE_SERVICE_MASTER_KEY_V1`, ...) or, for JWT
// signing keys, by version (`JWT_SIGNING_KEY_V{n}`; `created_at` is when the
// version starts signing, and a version is retired when the next one does). Written by `loadKeys()` and `rotateSigningKey()`
// (utils/keys.ts); an env value always takes precedence and is never stored.
// Each value is encrypted with the KEK (`kek1:<kek id>:<payload>`,
// utils/kek.ts); a plaintext row from before the KEK is encrypted in place on
// start.
model Secret {
  name      String   @id @db.VarChar(128)
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("secrets")
  @@schema("core")
}

// This deployment's own state. Exactly one row (id = 1, CHECK appended as raw
// SQL in the migration), created by the migration.
model Instance {
  id               Int       @id @default(1) @db.SmallInt
  setupCompletedAt DateTime? @map("setup_completed_at")
  setupCompletedBy String?   @map("setup_completed_by") @db.Uuid

  setupCompletedByUser User? @relation("InstanceSetupCompletedBy", fields: [setupCompletedBy], references: [id], onDelete: Restrict)

  @@map("instance")
  @@schema("core")
}

// One-time tokens that authorize first-boot setup. Each process start prints
// a fresh one while setup is pending; completing setup deletes them all.
// Stored as SHA-256 of the normalized token.
model SetupToken {
  hash      String   @id @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("setup_tokens")
  @@schema("core")
}

enum ServiceKind {
  service
  integration

  @@map("service_kind")
  @@schema("core")
}

// An app service, or core itself (fixed id, no client). Provisioned, with a
// declaration of what it owns, all named under its namespace; or added by an
// admin, who gets its client credentials once. Never deleted.
//
// An integration is a machine client for an external party: no namespace, it
// never declares anything. With an organization (fixed at creation) its
// tokens carry that org_id and its account holds org roles there; without
// one it holds global roles. CHECKs keep namespace and organization_id to
// their kind.
model Service {
  id                 String      @id @default(uuid(7)) @db.Uuid
  slug               String      @unique @db.VarChar(64)
  name               String      @db.VarChar(100)
  kind               ServiceKind @default(service)
  namespace          String?     @unique @db.VarChar(64)
  organizationId     String?     @map("organization_id") @db.Uuid
  clientId           String?     @unique @map("client_id") @db.Uuid
  isActive           Boolean     @default(true) @map("is_active")
  // Set by provisioning: the host its own webhook endpoints may reach at a
  // private address (utils/ssrfGuard.ts).
  internalHost       String?     @map("internal_host") @db.VarChar(253)
  declarationHash    String?     @map("declaration_hash") @db.Char(64)
  // The semver of the declaration last applied; an older one is ignored.
  declarationVersion String?     @map("declaration_version") @db.VarChar(64)
  declaredAt         DateTime?   @map("declared_at")
  // Created from the provisioning file.
  provisioned        Boolean     @default(false)
  // When a provisioned service was first missing from the file.
  unprovisionedAt    DateTime?   @map("unprovisioned_at")
  createdBy          String      @map("created_by") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  client           OAuthClient?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator          User              @relation("ServiceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  permissions      Permission[]
  roles            Role[]
  buckets          Bucket[]
  eventTypes       EventType[]
  access           ServiceAccess[]
  webhookEndpoints WebhookEndpoint[]

  @@index([organizationId])
  @@map("services")
  @@schema("core")
}

enum ServiceAccessKind {
  role
  audience

  @@map("service_access_kind")
  @@schema("core")
}

enum ServiceAccessStatus {
  pending
  approved
  revoked

  @@map("service_access_status")
  @@schema("core")
}

// Access a service asked for in its declaration: another service's system
// role (`target` = "<slug>/<name>", or a bare name for core's), or an
// audience (`target` = a service slug). Nothing applies until an admin
// approves it. Rows are additive — a later declaration that drops an item
// leaves its decision standing.
model ServiceAccess {
  id                    String              @id @default(uuid(7)) @db.Uuid
  serviceId             String              @map("service_id") @db.Uuid
  kind                  ServiceAccessKind
  target                String              @db.VarChar(200)
  status                ServiceAccessStatus @default(pending)
  requestedAt           DateTime            @default(now()) @map("requested_at")
  decidedAt             DateTime?           @map("decided_at")
  decidedBy             String?             @map("decided_by") @db.Uuid
  // A role's approved permissions, recorded at approval and brought up to
  // what the role grants on each provisioning apply.
  approvedPermissionIds String[]            @default([]) @map("approved_permission_ids") @db.Uuid

  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  decider    User?     @relation("ServiceAccessDecider", fields: [decidedBy], references: [id], onDelete: Restrict)
  assignment UserRole?

  @@unique([serviceId, kind, target])
  @@index([status])
  @@map("service_access")
  @@schema("core")
}

// ===========================================================================
// notifications
// ===========================================================================

enum NotificationChannel {
  email

  @@schema("notifications")
}

enum NotificationStatus {
  pending
  sent
  partial
  failed

  @@schema("notifications")
}

enum NotificationDeliveryStatus {
  pending
  sending
  sent
  failed

  @@schema("notifications")
}

// A configured way to send on a channel. A connection that deliveries
// reference is disabled, not deleted. `secrets` is sealed with
// sealRowSecret and never returned by the API.
//
// Raw SQL in the migration: unique (channel) WHERE is_default.
model NotificationConnection {
  id           String              @id @default(uuid(7)) @db.Uuid
  channel      NotificationChannel
  slug         String              @db.VarChar(50)
  displayName  String              @map("display_name") @db.VarChar(100)
  isDefault    Boolean             @default(false) @map("is_default")
  isEnabled    Boolean             @default(true) @map("is_enabled")
  settings     Json
  secrets      String?
  maxPerMinute Int?                @map("max_per_minute")
  createdBy    String              @map("created_by") @db.Uuid
  updatedBy    String              @map("updated_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  creator       User                   @relation("NotificationConnectionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater       User                   @relation("NotificationConnectionUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  notifications Notification[]
  deliveries    NotificationDelivery[]

  @@unique([channel, slug])
  @@map("connections")
  @@schema("notifications")
}

// One row per send request. Partitioned by day on created_at, which is why
// the primary key includes it; the migration's raw SQL does the partitioning.
model Notification {
  id             String              @default(uuid(7)) @db.Uuid
  channel        NotificationChannel
  connectionId   String?             @map("connection_id") @db.Uuid
  senderUserId   String              @map("sender_user_id") @db.Uuid
  organizationId String?             @map("organization_id") @db.Uuid
  recipients     Json
  // Null once every delivery is sent.
  content        Json?
  // A one-line description for the log, from the channel (email: the subject).
  summary        String?             @map("summary") @db.VarChar(998)
  attachments    Json
  // What the sender's token carried at accept (`{ organizationId, ceiling? }`),
  // so the delivery worker can check the attachments are still readable. Null
  // when core sent it.
  senderAccess   Json?               @map("sender_access")
  status         NotificationStatus  @default(pending)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  connection   NotificationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  sender       User                    @relation("NotificationSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries   NotificationDelivery[]

  @@id([id, createdAt])
  @@index([createdAt])
  @@index([senderUserId, createdAt])
  @@index([status])
  @@map("notifications")
  @@schema("notifications")
}

// One row per actual send. Partitioned by day on notification_created_at so a
// notification and its deliveries share a partition day; the composite foreign
// key to notifications (id, created_at) is generated by Prisma.
model NotificationDelivery {
  id                    String                     @default(uuid(7)) @db.Uuid
  notificationId        String                     @map("notification_id") @db.Uuid
  notificationCreatedAt DateTime                   @map("notification_created_at")
  connectionId          String?                    @map("connection_id") @db.Uuid
  recipients            Json
  status                NotificationDeliveryStatus @default(pending)
  attempts              Int                        @default(0)
  lastError             String?                    @map("last_error") @db.VarChar(2048)
  providerMessageId     String?                    @map("provider_message_id") @db.VarChar(255)
  providerResponse      String?                    @map("provider_response") @db.VarChar(4096)
  sentAt                DateTime?                  @map("sent_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  notification Notification            @relation(fields: [notificationId, notificationCreatedAt], references: [id, createdAt], onDelete: Restrict)
  connection   NotificationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@id([id, notificationCreatedAt])
  @@index([notificationId, notificationCreatedAt])
  @@index([status, updatedAt])
  @@map("deliveries")
  @@schema("notifications")
}
