// One schema for all of tereo. Each module owns a Postgres schema;
// `core` holds shared infrastructure: the outbox, keys, setup state, and the
// registry of services.
//
// Migrations are generated by `prisma migrate dev`. Features Prisma cannot
// express — range partitioning, partial and opclass indexes, CHECK constraints
// — are appended as raw SQL to the generated migration (`--create-only`).

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "files", "webhooks", "audit", "core", "notifications"]
}

// ===========================================================================
// auth
// ===========================================================================

enum OrgMemberRole {
  owner
  admin
  member

  @@map("org_member_role")
  @@schema("auth")
}

model Organization {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @db.VarChar(255)
  slug       String    @unique @db.VarChar(100)
  code       String    @unique @db.VarChar(6)
  isDefault  Boolean   @default(false) @map("is_default")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  members                 OrganizationMember[]
  clients                 OAuthClient[]
  userRoles               UserRole[]
  consentSessions         ConsentSession[]
  authorizationCodes      AuthorizationCode[]
  refreshTokens           RefreshToken[]
  accessTokens            AccessToken[]
  userSessions            UserSession[]
  buckets                 Bucket[]
  webhookEndpoints        WebhookEndpoint[]
  auditLogEntries         AuditLogEntry[]
  identityProviderDomains IdentityProviderDomain[]
  integrations            Service[]

  notifications Notification[]

  @@index([isActive])
  @@index([archivedAt])
  @@map("organizations")
  @@schema("auth")
}

model OrganizationMember {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  memberRole     OrgMemberRole @default(member) @map("member_role")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
  @@schema("auth")
}

model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  email          String    @unique @db.VarChar(255)
  passwordHash   String?   @map("password_hash") @db.VarChar(255)
  name           String?   @db.VarChar(100)
  firstName      String?   @map("first_name") @db.VarChar(100)
  lastName       String?   @map("last_name") @db.VarChar(100)
  userType       UserType  @default(human) @map("user_type")
  oauthClientId  String?   @unique @map("oauth_client_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  totpSecret     String?   @map("totp_secret") @db.VarChar(255)
  totpEnabled    Boolean   @default(false) @map("totp_enabled")
  totpEnabledAt  DateTime? @map("totp_enabled_at")
  // The 30-second step of the last TOTP code accepted for the current secret;
  // a code from this step or an earlier one is refused as a replay.
  totpLastWindow Int?      @map("totp_last_window")
  photoObjectId  String?   @map("photo_object_id") @db.Uuid

  authCodes               AuthorizationCode[]
  refreshTokens           RefreshToken[]
  userRoles               UserRole[]
  recoveryCodes           RecoveryCode[]
  totpVerifications       TotpVerification[]
  consentSessions         ConsentSession[]
  userSessions            UserSession[]
  organizationMembers     OrganizationMember[]
  orgSelectionSessions    OrgSelectionSession[]
  accessTokens            AccessToken[]
  totpSetupSessions       TotpSetupSession[]
  totpSetupGrants         TotpSetupGrant[]
  webhookEndpointsCreated WebhookEndpoint[]     @relation("WebhookEndpointCreator")
  ownedClients            OAuthClient[]         @relation("ClientOwner")
  oauthClient             OAuthClient?          @relation("ServiceAccountClient", fields: [oauthClientId], references: [id], onDelete: SetNull)

  // Actor columns in files and audit. Users are deactivated, never deleted.
  bucketsCreated            Bucket[]            @relation("BucketCreator")
  bucketsDeleted            Bucket[]            @relation("BucketDeleter")
  objectsCreated            Object[]            @relation("ObjectCreator")
  objectsDeleted            Object[]            @relation("ObjectDeleter")
  objectVersionsCreated     ObjectVersion[]     @relation("ObjectVersionCreator")
  objectVersionsDeleted     ObjectVersion[]     @relation("ObjectVersionDeleter")
  multipartUploadsCreated   MultipartUpload[]   @relation("MultipartUploadCreator")
  bucketPermissions         BucketPermission[]  @relation("BucketPermissionUser")
  bucketPermissionsGranted  BucketPermission[]  @relation("BucketPermissionGranter")
  bucketPermissionsRevoked  BucketPermission[]  @relation("BucketPermissionRevoker")
  accessLogs                AccessLog[]         @relation("AccessLogUser")
  archiveRequestsCreated    ArchiveRequest[]    @relation("ArchiveRequestCreator")
  sharesCreated             Share[]             @relation("ShareCreator")
  sharesRevoked             Share[]             @relation("ShareRevoker")
  idempotencyRecordsCreated IdempotencyRecord[] @relation("IdempotencyRecordCreator")
  auditLogEntries           AuditLogEntry[]     @relation("AuditLogEntryUser")
  auditLogEntriesWritten    AuditLogEntry[]     @relation("AuditLogEntryWriter")
  instanceSetUp             Instance[]          @relation("InstanceSetupCompletedBy")
  servicesCreated           Service[]           @relation("ServiceCreator")
  serviceAccessDecided      ServiceAccess[]     @relation("ServiceAccessDecider")

  // Identity providers
  identityProvidersCreated       IdentityProvider[]       @relation("IdentityProviderCreator")
  identityProviderDomainsCreated IdentityProviderDomain[] @relation("IdentityProviderDomainCreator")
  identities                     UserIdentity[]           @relation("UserIdentityUser")
  identityInvites                IdentityInvite[]         @relation("IdentityInviteUser")
  identityInvitesCreated         IdentityInvite[]         @relation("IdentityInviteCreator")
  upstreamAuthSessions           UpstreamAuthSession[]
  identityLinkGrants             IdentityLinkGrant[]

  // Actor columns in notifications.
  notificationConnectionsCreated NotificationConnection[] @relation("NotificationConnectionCreator")
  notificationConnectionsUpdated NotificationConnection[] @relation("NotificationConnectionUpdater")
  notificationsSent              Notification[]           @relation("NotificationSender")

  @@index([isActive])
  @@index([createdAt])
  @@index([userType])
  @@map("users")
  @@schema("auth")
}

model OAuthClient {
  id                      String     @id @default(uuid(7)) @db.Uuid
  clientId                String     @unique @map("client_id") @db.VarChar(64)
  clientSecret            String?    @unique @map("client_secret") @db.VarChar(255)
  clientType              ClientType @default(confidential) @map("client_type")
  name                    String     @db.VarChar(100)
  redirectUris            String[]   @map("redirect_uris")
  postLogoutRedirectUris  String[]   @default([]) @map("post_logout_redirect_uris")
  scopes                  String[]
  grantTypes              String[]   @map("grant_types")
  // Service slugs whose holders may introspect this client's tokens.
  audience                String[]   @default([])
  // false: the user is not asked to approve this client after signing in.
  // Says nothing about what its tokens may do in core's API.
  consentRequired         Boolean    @default(true) @map("consent_required")
  // Core API scopes the user is not asked to approve when consentRequired is
  // false. Set only by provisioning; never core:admin or core:admin.read.
  trustedCoreScopes       String[]   @default([]) @map("trusted_core_scopes")
  // After a regenerate, the replaced secret keeps working until it expires,
  // so running copies of a service survive the rollout.
  previousSecretHash      String?    @map("previous_secret_hash") @db.VarChar(255)
  previousSecretExpiresAt DateTime?  @map("previous_secret_expires_at")
  // Hashes this client used before and may never use again: provisioning
  // refuses them, so a rollback cannot revive a revoked or leaked secret.
  retiredSecretHashes     String[]   @default([]) @map("retired_secret_hashes")
  // Created from the provisioning file.
  provisioned             Boolean    @default(false)
  // When a provisioned login client was first missing from the file.
  unprovisionedAt         DateTime?  @map("unprovisioned_at")
  ownerId                 String     @map("owner_id") @db.Uuid
  organizationId          String?    @map("organization_id") @db.Uuid
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  authCodes            AuthorizationCode[]
  accessTokens         AccessToken[]
  refreshTokens        RefreshToken[]
  consentSessions      ConsentSession[]
  totpVerifications    TotpVerification[]
  totpSetupSessions    TotpSetupSession[]
  totpSetupGrants      TotpSetupGrant[]
  orgSelectionSessions OrgSelectionSession[]
  upstreamAuthSessions UpstreamAuthSession[]
  identityLinkGrants   IdentityLinkGrant[]
  owner                User                  @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  serviceAccountUser   User?                 @relation("ServiceAccountClient")
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service              Service?

  @@index([ownerId])
  @@index([organizationId])
  @@map("oauth_clients")
  @@schema("auth")
}

model AuthorizationCode {
  id                  String    @id @default(uuid(7)) @db.Uuid
  // HMAC-SHA256 of the code under AUTH_CODE_HMAC_KEY: the lookup key. The
  // code itself is never stored.
  codeHash            String    @unique @map("code_hash") @db.VarChar(128)
  clientId            String    @map("client_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  organizationId      String?   @map("organization_id") @db.Uuid
  redirectUri         String    @map("redirect_uri") @db.VarChar(2048)
  scopes              String[]
  codeChallenge       String    @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String    @map("code_challenge_method") @db.VarChar(10)
  nonce               String?   @db.VarChar(512)
  authTime            DateTime  @map("auth_time")
  maxAge              Int?      @map("max_age")
  acrValues           String?   @map("acr_values") @db.VarChar(512)
  authMethods         String[]  @default([]) @map("auth_methods")
  // The SSO session (browser) the code was issued under. Its token family
  // ends with that session: logout in this browser revokes it.
  userSessionId       String?   @map("user_session_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  client        OAuthClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userSession   UserSession?   @relation(fields: [userSessionId], references: [id], onDelete: SetNull)
  accessTokens  AccessToken[]
  refreshTokens RefreshToken[]

  @@index([userSessionId])
  @@index([expiresAt])
  @@index([userId])
  @@index([clientId])
  @@index([organizationId])
  @@map("authorization_codes")
  @@schema("auth")
}

model AccessToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  jti            String    @unique @db.VarChar(64)
  clientId       String    @map("client_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  authCodeId     String?   @map("auth_code_id") @db.Uuid
  refreshTokenId String?   @map("refresh_token_id") @db.Uuid
  scopes         String[]
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  client       OAuthClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // For a client_credentials token, the client's service-account user.
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authCode     AuthorizationCode? @relation(fields: [authCodeId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken?      @relation(fields: [refreshTokenId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
  @@index([organizationId])
  @@index([clientId, revokedAt, expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([authCodeId, revokedAt, expiresAt])
  @@index([refreshTokenId, revokedAt, expiresAt])
  @@map("access_tokens")
  @@schema("auth")
}

model RefreshToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  tokenPrefix    String    @map("token_prefix") @db.VarChar(16)
  clientId       String    @map("client_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  authCodeId     String?   @map("auth_code_id") @db.Uuid
  scopes         String[]
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  // Set with revokedAt when the token was spent on a refresh (rotation),
  // not ended by a logout or an admin.
  rotatedAt      DateTime? @map("rotated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  client       OAuthClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authCode     AuthorizationCode? @relation(fields: [authCodeId], references: [id], onDelete: Cascade)
  accessTokens AccessToken[]

  @@index([tokenPrefix])
  @@index([authCodeId, revokedAt])
  @@index([revokedAt])
  @@index([organizationId])
  @@index([userId, revokedAt, expiresAt])
  @@index([clientId, revokedAt])
  @@map("refresh_tokens")
  @@schema("auth")
}

model Scope {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  @@map("scopes")
  @@schema("auth")
}

// Declared in code by a service (core included) and registered at boot.
// Admins never create one. `missing_since` is set when a declaration stops
// listing it; the retirement job sets `retired_at` after the grace period.
// A retired permission grants nothing but stays on the roles that hold it.
model Permission {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String    @unique @db.VarChar(100)
  displayName   String    @map("display_name") @db.VarChar(255)
  description   String?   @db.VarChar(500)
  serviceId     String    @map("service_id") @db.Uuid
  // Declared by the owning service. Only these count in a role assigned
  // within an organization.
  orgAssignable Boolean   @default(false) @map("org_assignable")
  missingSince  DateTime? @map("missing_since")
  retiredAt     DateTime? @map("retired_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId])
  @@index([retiredAt])
  @@map("permissions")
  @@schema("auth")
}

// A system role has a `service_id`: declared in code, read-only to admins,
// unique per service. A custom role has none: made by an admin, unique by
// name among custom roles (partial unique index in migration SQL).
model Role {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String    @db.VarChar(100)
  displayName     String    @map("display_name") @db.VarChar(255)
  description     String?   @db.VarChar(500)
  serviceId       String?   @map("service_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  requires2fa     Boolean   @default(false) @map("requires_2fa")
  missingSince    DateTime? @map("missing_since")
  retiredAt       DateTime? @map("retired_at")
  // Declared in a provisioning document; read-only through the admin API.
  provisioned     Boolean   @default(false)
  unprovisionedAt DateTime? @map("unprovisioned_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  rolePermissions             RolePermission[]
  userRoles                   UserRole[]
  service                     Service?                     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  identityProviderDomainRoles IdentityProviderDomainRole[]

  @@unique([serviceId, name])
  @@index([name])
  @@index([archivedAt])
  @@map("roles")
  @@schema("auth")
}

model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("auth")
}

model UserRole {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime? @map("expires_at")
  // Set when the assignment is a service's approved access to another
  // service's role: it then grants only the role's permissions that access
  // approved (`service_access.approved_permission_ids`).
  serviceAccessId String?   @unique @map("service_access_id") @db.Uuid

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceAccess ServiceAccess? @relation(fields: [serviceAccessId], references: [id], onDelete: Cascade)

  // Uniqueness enforced via partial unique indexes in migration SQL:
  // - user_roles_user_id_role_id_org_id_key: (user_id, role_id, organization_id) WHERE organization_id IS NOT NULL
  // - user_roles_user_id_role_id_global_key: (user_id, role_id) WHERE organization_id IS NULL
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@map("user_roles")
  @@schema("auth")
}

enum UserType {
  human
  service_account

  @@map("user_type")
  @@schema("auth")
}

enum ClientType {
  confidential
  public

  @@map("client_type")
  @@schema("auth")
}

// TOTP 2FA Models

model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, usedAt])
  @@map("recovery_codes")
  @@schema("auth")
}

model SystemSetting {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
  @@schema("auth")
}

// The cookie and the UI carry the token; only its SHA-256 is stored.
model TotpVerification {
  id                  String   @id @default(uuid(7)) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  tokenHash           String   @unique @map("token_hash") @db.VarChar(64)
  clientId            String   @map("client_id") @db.Uuid
  redirectUri         String   @map("redirect_uri") @db.VarChar(2048)
  scopes              String[]
  state               String?  @db.VarChar(512)
  codeChallenge       String   @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String   @map("code_challenge_method") @db.VarChar(10)
  nonce               String?  @db.VarChar(512)
  maxAge              Int?     @map("max_age")
  acrValues           String?  @map("acr_values") @db.VarChar(512)
  prompt              String?  @db.VarChar(50)
  firstFactor         String[] @default(["pwd"]) @map("first_factor")
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("totp_verifications")
  @@schema("auth")
}

// Single-use; only the SHA-256 of the grant handed to the UI is stored.
model TotpSetupGrant {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tokenHash           String   @unique @map("token_hash") @db.VarChar(64)
  userId              String   @map("user_id") @db.Uuid
  clientId            String   @map("client_id") @db.Uuid
  redirectUri         String   @map("redirect_uri") @db.VarChar(2048)
  scopes              String[]
  state               String?  @db.VarChar(512)
  codeChallenge       String   @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String   @map("code_challenge_method") @db.VarChar(10)
  nonce               String?  @db.VarChar(512)
  maxAge              Int?     @map("max_age")
  acrValues           String?  @map("acr_values") @db.VarChar(512)
  prompt              String?  @db.VarChar(50)
  firstFactor         String[] @default(["pwd"]) @map("first_factor")
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("totp_setup_grants")
  @@schema("auth")
}

model TotpSetupSession {
  id                  String   @id @default(uuid(7)) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  // SHA-256 (hex) of the setup token the user holds.
  tokenHash           String   @unique @map("token_hash") @db.VarChar(64)
  totpSecret          String   @map("totp_secret") @db.VarChar(255)
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")
  clientId            String?  @map("client_id") @db.Uuid
  redirectUri         String?  @map("redirect_uri") @db.VarChar(2048)
  state               String?  @db.VarChar(512)
  scope               String?  @db.VarChar(512)
  codeChallenge       String?  @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String?  @map("code_challenge_method") @db.VarChar(10)
  nonce               String?  @db.VarChar(512)
  maxAge              Int?     @map("max_age")
  acrValues           String?  @map("acr_values") @db.VarChar(512)
  prompt              String?  @db.VarChar(50)

  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Null when set up from the account page rather than during a login.
  client OAuthClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("totp_setup_sessions")
  @@schema("auth")
}

// The cookie and the UI carry the token; only its SHA-256 is stored.
model ConsentSession {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tokenHash           String   @unique @map("token_hash") @db.VarChar(64)
  userId              String   @map("user_id") @db.Uuid
  clientId            String   @map("client_id") @db.Uuid
  organizationId      String?  @map("organization_id") @db.Uuid
  redirectUri         String   @map("redirect_uri") @db.VarChar(2048)
  scopes              String[]
  state               String?  @db.VarChar(512)
  codeChallenge       String   @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String   @map("code_challenge_method") @db.VarChar(10)
  nonce               String?  @db.VarChar(512)
  authTime            DateTime @map("auth_time")
  maxAge              Int?     @map("max_age")
  acrValues           String?  @map("acr_values") @db.VarChar(512)
  prompt              String?  @db.VarChar(50)
  authMethods         String[] @default([]) @map("auth_methods")
  // The SSO session an org switch continues, without a password; null after
  // a login with credentials. The step ends with that session.
  userSessionId       String?  @map("user_session_id") @db.Uuid
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  client       OAuthClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userSession  UserSession?  @relation(fields: [userSessionId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([organizationId])
  @@index([userSessionId])
  @@index([userId, clientId, expiresAt])
  @@index([expiresAt])
  @@map("consent_sessions")
  @@schema("auth")
}

model UserSession {
  id             String   @id @default(uuid(7)) @db.Uuid
  // SHA-256 (hex) of the token in the browser's SSO cookie.
  tokenHash      String   @unique @map("token_hash") @db.VarChar(64)
  userId         String   @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  authTime       DateTime @map("auth_time")
  authMethods    String[] @default([]) @map("auth_methods")
  acrValue       String?  @map("acr_value") @db.VarChar(100)
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authorizationCodes AuthorizationCode[]
  consentSessions    ConsentSession[]

  @@index([organizationId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@map("user_sessions")
  @@schema("auth")
}

// The cookie and the UI carry the token; only its SHA-256 is stored.
model OrgSelectionSession {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tokenHash           String   @unique @map("token_hash") @db.VarChar(64)
  userId              String   @map("user_id") @db.Uuid
  clientId            String   @map("client_id") @db.Uuid
  redirectUri         String   @map("redirect_uri") @db.VarChar(2048)
  scopes              String[]
  state               String?  @db.VarChar(512)
  codeChallenge       String   @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String   @map("code_challenge_method") @db.VarChar(10)
  nonce               String?  @db.VarChar(512)
  authTime            DateTime @map("auth_time")
  maxAge              Int?     @map("max_age")
  acrValues           String?  @map("acr_values") @db.VarChar(512)
  prompt              String?  @db.VarChar(50)
  authMethods         String[] @default([]) @map("auth_methods")
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("org_selection_sessions")
  @@schema("auth")
}

// ===========================================================================
// auth — identity providers
// ===========================================================================

enum IdentityProviderKind {
  oidc

  @@map("identity_provider_kind")
  @@schema("auth")
}

enum UpstreamAuthPurpose {
  login
  link
  forced_link

  @@map("upstream_auth_purpose")
  @@schema("auth")
}

model IdentityProvider {
  id           String               @id @default(uuid(7)) @db.Uuid
  slug         String               @unique @db.VarChar(50)
  displayName  String               @map("display_name") @db.VarChar(100)
  kind         IdentityProviderKind
  issuer       String?              @db.VarChar(512)
  clientId     String               @map("client_id") @db.VarChar(255)
  // Sealed under the KEK; never stored or returned in the clear.
  clientSecret String               @map("client_secret")
  scopes       String[]             @default(["openid", "email", "profile"])
  countsAsMfa  Boolean              @default(false) @map("counts_as_mfa")
  isActive     Boolean              @default(true) @map("is_active")
  createdBy    String               @map("created_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  creator              User                     @relation("IdentityProviderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  domains              IdentityProviderDomain[]
  identities           UserIdentity[]
  invites              IdentityInvite[]
  upstreamAuthSessions UpstreamAuthSession[]

  @@map("identity_providers")
  @@schema("auth")
}

model IdentityProviderDomain {
  id             String   @id @default(uuid(7)) @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  domain         String   @unique @db.VarChar(255)
  organizationId String   @map("organization_id") @db.Uuid
  autoAccept     Boolean  @default(false) @map("auto_accept")
  ssoOnly        Boolean  @default(false) @map("sso_only")
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  provider     IdentityProvider             @relation(fields: [providerId], references: [id], onDelete: Restrict)
  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User                         @relation("IdentityProviderDomainCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  roles        IdentityProviderDomainRole[]

  @@index([providerId])
  @@index([organizationId])
  @@map("identity_provider_domains")
  @@schema("auth")
}

model IdentityProviderDomainRole {
  id       String @id @default(uuid(7)) @db.Uuid
  domainId String @map("domain_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  domain IdentityProviderDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  role   Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([domainId, roleId])
  @@index([roleId])
  @@map("identity_provider_domain_roles")
  @@schema("auth")
}

model UserIdentity {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  providerId  String    @map("provider_id") @db.Uuid
  subject     String    @db.VarChar(255)
  // Last seen at the provider; display only.
  email       String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  user     User             @relation("UserIdentityUser", fields: [userId], references: [id], onDelete: Restrict)
  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, subject])
  @@unique([userId, providerId])
  @@map("user_identities")
  @@schema("auth")
}

model IdentityInvite {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  createdBy  String   @map("created_by") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User             @relation("IdentityInviteUser", fields: [userId], references: [id], onDelete: Restrict)
  creator  User             @relation("IdentityInviteCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([userId, providerId])
  @@index([providerId])
  @@index([expiresAt])
  @@map("identity_invites")
  @@schema("auth")
}

// One round trip to a provider; only the SHA-256 of `state` is stored.
model UpstreamAuthSession {
  id                  String              @id @default(uuid(7)) @db.Uuid
  stateHash           String              @unique @map("state_hash") @db.VarChar(64)
  providerId          String              @map("provider_id") @db.Uuid
  purpose             UpstreamAuthPurpose
  userId              String?             @map("user_id") @db.Uuid
  nonce               String              @db.VarChar(128)
  codeVerifier        String              @map("code_verifier") @db.VarChar(128)
  // The core authorize request, for login and forced_link; null for link.
  clientId            String?             @map("client_id") @db.Uuid
  redirectUri         String?             @map("redirect_uri") @db.VarChar(2048)
  scopes              String[]            @default([])
  state               String?             @db.VarChar(512)
  codeChallenge       String?             @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String?             @map("code_challenge_method") @db.VarChar(10)
  clientNonce         String?             @map("client_nonce") @db.VarChar(512)
  maxAge              Int?                @map("max_age")
  acrValues           String?             @map("acr_values") @db.VarChar(512)
  prompt              String?             @db.VarChar(50)
  linkGrantId         String?             @map("link_grant_id") @db.Uuid
  expiresAt           DateTime            @map("expires_at")
  createdAt           DateTime            @default(now()) @map("created_at")

  provider  IdentityProvider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  user      User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  client    OAuthClient?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  linkGrant IdentityLinkGrant? @relation(fields: [linkGrantId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([userId])
  @@index([expiresAt])
  @@map("upstream_auth_sessions")
  @@schema("auth")
}

// A correct password for an SSO-only user without a link. Single-use; only
// the SHA-256 of the grant is stored. It allows nothing but a forced_link.
model IdentityLinkGrant {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tokenHash           String   @unique @map("token_hash") @db.VarChar(64)
  userId              String   @map("user_id") @db.Uuid
  clientId            String   @map("client_id") @db.Uuid
  redirectUri         String   @map("redirect_uri") @db.VarChar(2048)
  scopes              String[]
  state               String?  @db.VarChar(512)
  codeChallenge       String   @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String   @map("code_challenge_method") @db.VarChar(10)
  nonce               String?  @db.VarChar(512)
  maxAge              Int?     @map("max_age")
  acrValues           String?  @map("acr_values") @db.VarChar(512)
  prompt              String?  @db.VarChar(50)
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  client               OAuthClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  upstreamAuthSessions UpstreamAuthSession[]

  @@index([userId])
  @@index([expiresAt])
  @@map("identity_link_grants")
  @@schema("auth")
}

// ===========================================================================
// files
// ===========================================================================

model Bucket {
  id                Int          @id @default(autoincrement())
  // Unique among live buckets only: a partial unique index in raw SQL
  // (`buckets_live_name_key`), so a deleted bucket frees its name.
  name              String       @db.VarChar(255)
  description       String?      @db.VarChar(500)
  policy            BucketPolicy @default(private)
  storageQuotaBytes BigInt?      @map("storage_quota_bytes")
  currentUsageBytes BigInt       @default(0) @map("current_usage_bytes")
  versioningEnabled Boolean      @default(false) @map("versioning_enabled")
  autoThumbnails    Boolean      @default(false) @map("auto_thumbnails")
  corsConfig        Json?        @map("cors_config")
  rateLimitConfig   Json?        @map("rate_limit_config")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  createdBy         String       @map("created_by") @db.Uuid
  deletedAt         DateTime?    @map("deleted_at")
  deletedBy         String?      @map("deleted_by") @db.Uuid
  organizationId    String?      @map("organization_id") @db.Uuid
  // Set for buckets a service declared. A retired one is read-only.
  serviceId         String?      @map("service_id") @db.Uuid
  missingSince      DateTime?    @map("missing_since")
  retiredAt         DateTime?    @map("retired_at")

  objects          Object[]
  permissions      BucketPermission[]
  accessLogs       AccessLog[]
  multipartUploads MultipartUpload[]
  archiveRequests  ArchiveRequest[]
  shares           Share[]
  lifecyclePolicy  BucketLifecyclePolicy?
  creator          User                   @relation("BucketCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deleter          User?                  @relation("BucketDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service          Service?               @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([policy])
  @@index([serviceId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([organizationId])
  @@map("buckets")
  @@schema("files")
}

model ContentBlob {
  hash             String    @id @db.VarChar(64)
  sizeBytes        BigInt    @map("size_bytes")
  fsPath           String    @map("fs_path") @db.VarChar(1024)
  refCount         Int       @default(0) @map("ref_count")
  wrappedDek       Bytes     @map("wrapped_dek")
  iv               Bytes
  masterKeyVersion Int       @map("master_key_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  orphanedAt       DateTime? @map("orphaned_at")

  objectVersions ObjectVersion[]

  @@index([orphanedAt])
  @@map("content_blobs")
  @@schema("files")
}

// An Object is a pure identity row: a name within a bucket. It owns no content
// directly — content, size, etag, content-type, metadata, and tags all live on
// the attached ObjectVersion rows. The "current" version is the one with
// isCurrent=true; for non-versioned buckets there is always exactly one
// non-deleted version per Object.
//
// `id` is a UUID — the stable external identifier used by every API route
// that mutates an object (see `routes/.../objects/by-id/object/`). Reads still address
// objects by `objectKey` for human-readable URLs; only writes bind to the
// identity-stable `id`.
model Object {
  // UUIDv7 is time-ordered — inserts append to the right of the B-tree index
  // instead of scattering across it, and `ORDER BY id ASC` gives natural
  // insertion order. Supported by Prisma 5.18+.
  id            String    @id @default(uuid(7)) @db.Uuid
  bucketId      Int       @map("bucket_id")
  objectKey     String    @map("object_key") @db.VarChar(1024)
  deleteAfter   DateTime? @map("delete_after")
  thumbnailFor  String?   @map("thumbnail_for") @db.Uuid
  thumbnailSize String?   @map("thumbnail_size") @db.VarChar(16)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String    @map("created_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by") @db.Uuid

  bucket      Bucket          @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  accessLogs  AccessLog[]
  versions    ObjectVersion[]
  shares      Share[]
  thumbnailOf Object?         @relation("ObjectThumbnails", fields: [thumbnailFor], references: [id], onDelete: Cascade)
  thumbnails  Object[]        @relation("ObjectThumbnails")
  creator     User            @relation("ObjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deleter     User?           @relation("ObjectDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)

  // A partial unique index on (bucketId, objectKey) WHERE deletedAt IS NULL is
  // declared as raw SQL in the init migration (`objects_bucket_live_key`).
  // Prisma's schema syntax cannot express partial unique indexes — same
  // precedent as `object_versions_one_current_per_object`.
  @@index([bucketId, objectKey])
  @@index([objectKey])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([deleteAfter])
  @@index([thumbnailFor])
  @@map("objects")
  @@schema("files")
}

// An ObjectVersion is the content-bearing row. Size is not stored here — it's
// read through contentBlob.sizeBytes. Delete markers have null contentBlobHash,
// etag, and contentType; they exist only to tombstone the key in versioned
// buckets.
//
// Refcount rule: an ObjectVersion with deletedAt IS NULL, isDeleteMarker=false,
// and contentBlobHash IS NOT NULL holds exactly one reference on its blob.
model ObjectVersion {
  // UUIDv7 — same reasoning as `Object.id`. Even more impactful here because
  // ObjectVersion sees N inserts per object (versioned buckets + restores)
  // and is joined on `objectId` everywhere.
  id                    String    @id @default(uuid(7)) @db.Uuid
  objectId              String    @map("object_id") @db.Uuid
  contentBlobHash       String?   @map("content_blob_hash") @db.VarChar(64)
  etag                  String?   @db.VarChar(64)
  contentType           String?   @map("content_type") @db.VarChar(255)
  metadata              Json?
  tags                  String[]  @default([])
  isCurrent             Boolean   @default(false) @map("is_current")
  isDeleteMarker        Boolean   @default(false) @map("is_delete_marker")
  restoredFromVersionId String?   @map("restored_from_version_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String    @map("created_by") @db.Uuid
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             String?   @map("deleted_by") @db.Uuid

  object              Object                 @relation(fields: [objectId], references: [id], onDelete: Cascade)
  contentBlob         ContentBlob?           @relation(fields: [contentBlobHash], references: [hash], onDelete: SetNull)
  restoredFromVersion ObjectVersion?         @relation("VersionRestoreSource", fields: [restoredFromVersionId], references: [id], onDelete: SetNull)
  restoredAsVersions  ObjectVersion[]        @relation("VersionRestoreSource")
  shares              Share[]
  archiveEntries      ArchiveRequestObject[]
  creator             User                   @relation("ObjectVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deleter             User?                  @relation("ObjectVersionDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([contentBlobHash])
  @@index([objectId, isCurrent])
  @@index([objectId, createdAt])
  @@index([restoredFromVersionId])
  @@index([tags], type: Gin)
  @@map("object_versions")
  @@schema("files")
}

model MultipartUpload {
  // UUIDv7 — generated client-side via `uuid.v7()` so the id is known up-front
  // and can be used as AAD when wrapping the staging DEK (see `initiate` in
  // `utils/db/multipartUploads.ts`). Server-side default would defeat that
  // ordering since Prisma assigns the id at insert time.
  id                         String    @id @db.Uuid
  bucketId                   Int       @map("bucket_id")
  objectKey                  String    @map("object_key") @db.VarChar(1024)
  contentType                String    @map("content_type") @db.VarChar(255)
  metadata                   Json?
  tags                       String[]  @default([])
  expectedSize               BigInt?   @map("expected_size")
  // Per-upload staging DEK (32 bytes random) wrapped under the master key with
  // AAD = uploadId. Each part is encrypted on disk with this DEK + a fresh
  // 12-byte IV that's prepended to the part file. On `complete` the staging
  // DEK is unwrapped, parts are decrypted while concatenating, then the
  // concatenated plaintext is re-encrypted under the final blob DEK.
  wrappedStagingDek          Bytes     @map("wrapped_staging_dek")
  stagingDekMasterKeyVersion Int       @map("staging_dek_master_key_version")
  createdAt                  DateTime  @default(now()) @map("created_at")
  createdBy                  String    @map("created_by") @db.Uuid
  expiresAt                  DateTime  @map("expires_at")
  completedAt                DateTime? @map("completed_at")
  abortedAt                  DateTime? @map("aborted_at")

  bucket  Bucket          @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  parts   MultipartPart[]
  creator User            @relation("MultipartUploadCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([bucketId, completedAt])
  @@map("multipart_uploads")
  @@schema("files")
}

model MultipartPart {
  id         Int      @id @default(autoincrement())
  uploadId   String   @map("upload_id") @db.Uuid
  partNumber Int      @map("part_number")
  sizeBytes  BigInt   @map("size_bytes")
  etag       String   @db.VarChar(64)
  fsPath     String   @map("fs_path") @db.VarChar(1024)
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  upload MultipartUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, partNumber])
  @@map("multipart_parts")
  @@schema("files")
}

model BucketLifecyclePolicy {
  id                        Int      @id @default(autoincrement())
  bucketId                  Int      @unique @map("bucket_id")
  expireObjectsAfterDays    Int?     @map("expire_objects_after_days")
  expireVersionsAfterDays   Int?     @map("expire_versions_after_days")
  purgeSoftDeletedAfterDays Int?     @map("purge_soft_deleted_after_days")
  enabled                   Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  bucket Bucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@map("bucket_lifecycle_policies")
  @@schema("files")
}

model BucketPermission {
  id        Int       @id @default(autoincrement())
  bucketId  Int       @map("bucket_id")
  userId    String    @map("user_id") @db.Uuid
  canRead   Boolean   @default(false) @map("can_read")
  canWrite  Boolean   @default(false) @map("can_write")
  canDelete Boolean   @default(false) @map("can_delete")
  grantedAt DateTime  @default(now()) @map("granted_at")
  grantedBy String    @map("granted_by") @db.Uuid
  revokedAt DateTime? @map("revoked_at")
  revokedBy String?   @map("revoked_by") @db.Uuid

  bucket  Bucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  user    User   @relation("BucketPermissionUser", fields: [userId], references: [id], onDelete: Restrict)
  granter User   @relation("BucketPermissionGranter", fields: [grantedBy], references: [id], onDelete: Restrict)
  revoker User?  @relation("BucketPermissionRevoker", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@unique([bucketId, userId])
  @@index([userId])
  @@index([revokedAt])
  @@map("bucket_permissions")
  @@schema("files")
}

model AccessLog {
  id           BigInt   @id @default(autoincrement())
  bucketId     Int?     @map("bucket_id")
  objectId     String?  @map("object_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  operation    String   @db.VarChar(50)
  statusCode   Int      @map("status_code")
  ipAddress    String   @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  requestId    String?  @map("request_id") @db.VarChar(64)
  errorMessage String?  @map("error_message") @db.VarChar(1000)
  timestamp    DateTime @default(now())

  // Preserve audit-log trail when buckets or objects are purged by lifecycle.
  bucket Bucket? @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  object Object? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  user   User?   @relation("AccessLogUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([bucketId, timestamp])
  @@index([userId, timestamp])
  @@index([objectId, timestamp])
  @@index([timestamp])
  @@map("access_logs")
  @@schema("files")
}

// An ArchiveRequest is a server-side record of a folder-or-multi-object
// download that a user asked for. It captures a snapshot of object ids at
// create time (so deletions/additions between create and download don't
// change what's in the zip), a format + filename for the response, and an
// expiration that bounds the HMAC presigned URL's validity. Every download
// goes through the signed route — there is no "authenticated" download
// shortcut, which keeps audit coverage uniform and makes the URL shareable
// within its TTL.
model ArchiveRequest {
  id              String    @id @default(uuid(7)) @db.Uuid
  bucketId        Int       @map("bucket_id")
  prefix          String?   @db.VarChar(1024)
  format          String    @db.VarChar(8)
  filename        String    @db.VarChar(255)
  objectCount     Int       @map("object_count")
  totalSizeBytes  BigInt    @map("total_size_bytes")
  expiresAt       DateTime  @map("expires_at")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  downloadedAt    DateTime? @map("downloaded_at")

  bucket  Bucket                 @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  shares  Share[]
  objects ArchiveRequestObject[]
  creator User?                  @relation("ArchiveRequestCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([bucketId])
  @@index([expiresAt])
  @@map("archive_requests")
  @@schema("files")
}

// The object versions an ArchiveRequest snapshots, in download order. A
// version that is gone (purged, or replaced by a non-versioned overwrite)
// drops out (Cascade); `objectCount` keeps the count taken at creation.
model ArchiveRequestObject {
  archiveRequestId String @map("archive_request_id") @db.Uuid
  position         Int
  versionId        String @map("version_id") @db.Uuid

  archiveRequest ArchiveRequest @relation(fields: [archiveRequestId], references: [id], onDelete: Cascade)
  version        ObjectVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([archiveRequestId, position])
  @@index([versionId])
  @@map("archive_request_objects")
  @@schema("files")
}

// A Share is a DB-backed, revocable download link. Unlike stateless presigned
// URLs, a share persists as a row so the creator can list, revoke, password-
// protect, cap, or TTL-bound it. The share wraps either a single Object (kind=
// OBJECT, optionally pinned to a specific ObjectVersion) or an ArchiveRequest
// (kind=ARCHIVE) that was created server-side from a prefix or explicit key
// list during share creation.
//
// Public downloads resolve a share by its `token` (either a server-generated
// opaque random 18-byte token). On download the
// server mints a short-lived stateless presigned URL and 302-redirects — the
// existing signed-download handlers do the actual streaming, so this layer
// never duplicates that code.
model Share {
  id       String    @id @default(uuid(7)) @db.Uuid
  token    String    @unique @db.VarChar(64)
  bucketId Int       @map("bucket_id")
  kind     ShareKind

  objectId  String? @map("object_id") @db.Uuid
  versionId String? @map("version_id") @db.Uuid

  archiveRequestId String? @map("archive_request_id") @db.Uuid

  urlFilename String? @map("url_filename") @db.VarChar(255)

  passwordHash  String?   @map("password_hash")
  expiresAt     DateTime? @map("expires_at")
  maxDownloads  Int?      @map("max_downloads")
  downloadCount Int       @default(0) @map("download_count")

  revokedAt       DateTime? @map("revoked_at")
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  note            String?  @db.VarChar(500)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bucket         Bucket          @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  object         Object?         @relation(fields: [objectId], references: [id], onDelete: Cascade)
  // SetNull: pruning a pinned version unpins the share back to current-tracking
  // rather than orphaning the row.
  version        ObjectVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  archiveRequest ArchiveRequest? @relation(fields: [archiveRequestId], references: [id], onDelete: Cascade)
  creator        User            @relation("ShareCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revoker        User?           @relation("ShareRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  // Kind/target invariant enforced as a CHECK constraint in the migration —
  // Prisma's schema language cannot express cross-column check constraints.
  @@index([bucketId, createdAt(sort: Desc)])
  @@index([objectId])
  @@index([archiveRequestId])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@index([revokedAt])
  @@map("shares")
  @@schema("files")
}

model IdempotencyRecord {
  id             BigInt   @id @default(autoincrement())
  scope          String   @db.VarChar(128)
  key            String   @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")
  creator        User     @relation("IdempotencyRecordCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
  @@schema("files")
}

enum BucketPolicy {
  public
  private

  @@schema("files")
}

enum ShareKind {
  OBJECT
  ARCHIVE

  @@map("share_kind")
  @@schema("files")
}

