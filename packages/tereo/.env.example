# Copy to .env for `npm run dev` and local test runs. Everything here is
# optional for `docker compose up`, which sets its own URLs.
#
# Keys are generated on first start and stored in the database (core.secrets),
# encrypted with CORE_KEK. Set any of them here to supply it instead — an env
# value always wins and is never stored: JWT_PRIVATE_KEY / JWT_PUBLIC_KEY
# (base64 PEM, both or neither), TOTP_ENCRYPTION_KEY, CURSOR_SIGNING_KEY_V1,
# FILE_SERVICE_SIGNING_KEY_V1, FILE_SERVICE_MASTER_KEY_V1, AUTH_CODE_HMAC_KEY,
# KNOWN_DEVICE_KEY.

# Key-encryption key for core.secrets (base64, 32 bytes). Required with
# NODE_ENV=production; unset, development uses a fixed, public dev KEK and
# warns. Rows written under the dev KEK are re-encrypted once this is set;
# after that, keep it — the stored keys cannot be read without it.
# CORE_KEK=   # openssl rand -base64 32
# While rotating it: the old KEK, whose rows are re-encrypted under CORE_KEK on
# start (docs/configuration.md#rotating-the-kek).
# CORE_KEK_PREVIOUS=
#
# The first admin is created through setup: core logs a setup token on start.

# Matches docker-compose.yml's postgres/redis on their default host ports.
DATABASE_URL=postgresql://core:core@localhost:5442/core
REDIS_URL=redis://localhost:6389

PUBLIC_URL=http://localhost:4001
# The Vite dev server. To log in through the UI core serves at the root instead
# (after `npm run build -w tereo-ui`), use http://localhost:4001
# and re-run the seed.
UI_BASE_URL=http://localhost:4000

# Secure flag on core's cookies. Defaults to true when NODE_ENV=production and
# false otherwise; an explicit value wins, except that false is refused in
# production.
# COOKIE_SECURE=false

# Session lifetimes, in seconds — all absolute, none extended by use
# (docs/auth.md). Defaults shown; core refuses to start outside the bounds:
# access token 1-86400, refresh token and session at most 31536000,
# authorization code 1-600, login flow 1-3600 (docs/configuration.md).
# JWT_ACCESS_TOKEN_TTL=3600
# JWT_REFRESH_TOKEN_TTL=2592000
# USER_SESSION_TTL=604800
# AUTHORIZATION_CODE_TTL=120
# LOGIN_FLOW_TTL=900

# Allows SMTP connections with `security: "none"` (mail and password sent in
# the clear), for a local mail catcher. Default false.
ALLOW_PLAINTEXT_SMTP=true

# A JSON file, or a directory of *.json files, declaring the app services,
# login clients and custom roles core applies at every start
# (docs/provisioning.md). Unset: nothing is applied.
# PROVISIONING_PATH=./provisioning
