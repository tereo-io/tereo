{
  "name": "tereo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "NODE_OPTIONS='--import ./dist/telemetry/register.js' node dist/index.js",
    "dev": "tsx watch --import ./src/telemetry/register.ts src/index.ts",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:studio": "prisma studio",
    "test": "../../docker/test/run.sh",
    "test:local": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:logs": "../../docker/test/run.sh logs -f runner",
    "test:clean": "../../docker/test/run.sh down -v",
    "cli": "tsx src/cli/index.ts",
    "openapi:lint": "redocly lint",
    "openapi:build": "redocly lint && redocly bundle"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/instrumentation": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "10.0.11",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "rate-limiter-flexible": "^11.2.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "undici": "^6.29.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@redocly/cli": "^2.63.0",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "3.4.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.9.9",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "3.5.13",
    "form-data": "^4.0.6",
    "mailparser": "3.9.29",
    "smtp-server": "3.19.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
